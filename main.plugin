#!name = 9monster Private Album
#!desc = 自动采集图片并生成 Loon 本地相册；访问 http://album.loon.invalid/
#!loon_version = 3.5.1(983)
#!date = 2026-10-18

[Argument]
notify = switch,true,tag=新增图片通知

[Script]
response if ${url} ~= /^https:\/\/api\.ninemonsters\.com\/other\/get\?(?:[^#]*&)?public_key(?:=[^&#]*)?(?:&|#|$)/ then script("https://raw.githubusercontent.com/fafatop/9monster-private/main/collect.fixed.js?v=1", {${notify}}) with requires_body=true, timeout=10, tag="采集图片列表"
request if ${url} ~= /^http:\/\/album\.loon\.invalid\/(?:\?[^#]*)?$/ then script("https://raw.githubusercontent.com/fafatop/9monster-private/main/gallery.fixed.js?v=1") with timeout=10, tag="图片相册"

[Host]
album.loon.invalid = 192.0.2.9

[Mitm]
hostname = api.ninemonsters.com

